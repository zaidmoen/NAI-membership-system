{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nai-membership-system.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://nai-membership-system.onrender.com/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://nai-membership-system.onrender.com/static/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
